{
  "name": "up-app",
  "version": "0.1.0",
  "private": true,
  "description": "Prototipo de comparador de precios de supermercados en Chile con carrito unificado y split payment simulado.",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "check-contrast": "node scripts/check-contrast.js",
    "build-catalog": "node scripts/build-catalog.js",
    "export-catalog": "node scripts/export-catalog.js",
    "validate-catalog": "node scripts/validate-catalog.js",
    "migrate-catalog": "node scripts/migrate-catalog.js",
    "check-freshness": "node scripts/check-freshness.js",
    "verify-links": "node scripts/verify-links.js",
    "sync": "node scripts/sync.js",
    "lint": "npm run lint:syntax && eslint .",
    "lint:syntax": "node --check server.js && node --check sw.js && node --check data/demo.js && node --check data/product-images.js && for f in lib/*.js scripts/*.js src/*.js test/*.js; do node --check \"$f\"; done",
    "format": "prettier --write 'lib/**/*.js' 'scripts/**/*.js' 'src/**/*.js' 'test/**/*.js' eslint.config.js",
    "format:check": "prettier --check 'lib/**/*.js' 'scripts/**/*.js' 'src/**/*.js' 'test/**/*.js' eslint.config.js"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.10.1"
  }
}
